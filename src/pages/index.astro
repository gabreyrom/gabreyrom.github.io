---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { aboutIntro, aboutBiography, expertiseAreas, technicalToolkit } from '../data/about';
import { skillCategories } from '../data/skills';
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
// Portrait shown on the About page — replace this file to swap the photo.
import portrait from '../assets/images/portrait.png';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
).slice(0, 3);

// Simple outline icons for the expertise cards, index-matched to `expertiseAreas`.
const expertiseIcons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"></polyline><polyline points="15 7 21 7 21 13"></polyline></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.4"></circle><circle cx="18" cy="6" r="2.4"></circle><circle cx="12" cy="18" r="2.4"></circle><line x1="8" y1="7.3" x2="10.3" y2="15.8"></line><line x1="16" y1="7.3" x2="13.7" y2="15.8"></line><line x1="8.4" y1="6" x2="15.6" y2="6"></line></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><circle cx="9" cy="6" r="1.6" fill="currentColor" stroke="none"></circle><line x1="4" y1="12" x2="20" y2="12"></line><circle cx="15" cy="12" r="1.6" fill="currentColor" stroke="none"></circle><line x1="4" y1="18" x2="20" y2="18"></line><circle cx="11" cy="18" r="1.6" fill="currentColor" stroke="none"></circle></svg>`,
];
---

<BaseLayout
  title={site.name}
  description="Personal site of Gabriel Reynoso Romero — data scientist in growth analytics, customer experimentation, and machine learning."
>
  <div class="intro">
    <Image
      class="intro__portrait"
      src={portrait}
      alt="Gabriel Reynoso Romero"
      width={200}
      height={250}
      format="webp"
      quality={80}
      loading="eager"
    />
    <div class="intro__content">
      <h1>{site.heading}</h1>
      <p class="intro__subtitle">{site.subtitle}</p>
      <p class="lede">{site.intro}</p>

      <p class="social-links">
        <a href={`mailto:${site.email}`}>{site.email}</a> ·
        <a href={site.github} target="_blank" rel="noopener">GitHub</a> ·
        <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </div>
  </div>

  <hr />

  <section class="about">
    <h2 class="about__heading">About Me</h2>
    <p class="lede about__intro">{aboutIntro}</p>

    <div class="about__grid">
      <div class="about__bio">
        {aboutBiography.map((paragraph) => (
          <p>{paragraph}</p>
        ))}

        <div class="toolkit">
          <p class="toolkit__label">Technical Toolkit</p>
          <ul class="toolkit-tags">
            {technicalToolkit.map((tool) => (
              <li class="toolkit-tag">{tool}</li>
            ))}
          </ul>
        </div>
      </div>

      <div class="about__expertise">
        {expertiseAreas.map((area, index) => (
          <article class="expertise-card">
            <span class="expertise-card__icon" aria-hidden="true" set:html={expertiseIcons[index]} />
            <h3 class="expertise-card__title">{area.title}</h3>
            <p class="expertise-card__description">{area.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <hr />

  <section class="skills">
    <h2 class="page-heading">Technical Skills</h2>
    <p class="lede page-subtitle">
      The tools and methods I use to explore data, build solutions, and support business decisions.
    </p>

    <div class="skill-grid">
      {
        skillCategories.map((category) => (
          <div class="skill-card">
            <h3 class="skill-card__title">{category.name}</h3>
            <ul class="tag-list">
              {category.tools.map((tool) => (
                <li class="tag">{tool}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <hr />

  <section class="featured">
    <h2 class="featured__heading">Featured Projects</h2>
    <p class="lede featured__intro">
      A selection of projects exploring predictive modeling, optimization, and engineering problems.
    </p>

    <div class="project-grid">
      {
        projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            summary={project.data.summary}
            technologies={project.data.technologies}
            highlights={project.data.highlights}
            repoUrl={project.data.repoUrl}
            href={project.data.caseStudy ? `/projects/${project.id}/` : undefined}
          />
        ))
      }
    </div>

    <p class="featured__cta"><a href="/projects/">View All Projects</a></p>
  </section>
</BaseLayout>
